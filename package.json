{
	"name": "themes-starter",
	"version": "3.0.0",
	"license": "GPL-2.0",
	"description": "A WordPress Starter Theme built with Bootstrap 5.",
	"homepage": "https://them.es",
	"author": "them.es",
	"repository": {
		"type": "git",
		"url": "git://github.com/them-es/themes-starter.git"
	},
	"scripts": {
		"start": "wp-scripts start --webpack-src-dir=assets",
		"build": "wp-scripts build --webpack-src-dir=assets && node scripts/site-stats.cjs",
		"deploy": "bash deploy/deploy.sh",
		"deploy:dry": "bash deploy/deploy.sh --dry-run",
		"pull": "bash deploy/pull-live.sh",
		"wp": "bash deploy/menu.sh",
		"lint:scss": "stylelint \"assets/**/*.scss\"",
		"lint:scss:fix": "npm run lint:scss -- --fix",
		"format:scss": "prettier --write \"assets/**/*.scss\"",
		"format:scss:check": "prettier --check \"assets/**/*.scss\"",
		"check:scss": "npm run format:scss:check && npm run lint:scss && npm run build"
	},
	"browserslist": [
		"last 2 versions"
	],
	"dependencies": {
		"@popperjs/core": "^2.11.8",
		"bootstrap": "^5.3.8",
		"jquery": "^3.7.0"
	},
	"devDependencies": {
		"@wordpress/scripts": "^27.7.0",
		"path": "^0.12.7",
		"postcss-scss": "4.0.9",
		"prettier": "3.0.3",
		"stylelint": "14.16.1",
		"stylelint-config-standard-scss": "6.1.0",
		"webpack-remove-empty-scripts": "^1.0.4"
	},
	"main": "webpack.config.js",
	"keywords": [],
	"bugs": {
		"url": "https://github.com/them-es/themes-starter/issues"
	}
}
